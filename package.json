{
  "name": "orgmanage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "generate:check": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test tests/contracts/*.test.mjs tests/ledger/*.test.mjs tests/core/*.test.mjs tests/host/*.test.mjs",
    "home:build": "vite build --config apps/home/vite.config.ts",
    "home:typecheck": "tsc --project apps/home/tsconfig.json",
    "home:start": "node scripts/start-home.mjs",
    "home:dev": "npm run home:typecheck && npm run home:build && npm run home:start",
    "verify": "npm run generate:check && npm run typecheck && npm run build && npm run home:typecheck && npm run home:build && npm test",
    "test:public": "node scripts/public-ci.mjs",
    "verify:public": "npm run generate:check && npm run typecheck && npm run build && npm run home:typecheck && npm run home:build && npm run test:public"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "canonicalize": "5.0.0",
    "electron": "44.3.0",
    "json-schema-to-typescript": "16.0.0",
    "jsonc-parser": "3.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
